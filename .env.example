# Example environment variables for ADN Developer
# Copy this file to .env.local and fill in the real values.

# Supabase (public client)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Supabase (server admin)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Email via Resend
RESEND_API_KEY=your-resend-api-key

# Base URL pública do app
NEXT_PUBLIC_APP_URL=https://adndeveloper.com

# Admin controle de acesso
ADMIN_EMAILS=admin@example.com,other@example.com
NEXTAUTH_SECRET=your-nextauth-secret

# Upstash Redis para rate limiting / manutenção
UPSTASH_REDIS_REST_URL=https://us1-xxxx.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-token

# Rota de manutenção / cron protegida
MAINTENANCE_SECRET_TOKEN=your-maintenance-secret
CRON_SECRET=your-cron-secret

# Telemetria/erros (opcional)
SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0
